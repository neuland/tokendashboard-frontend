# Copy this file to `.env` and fill in the values you need. No code change required.
# A build reads `.env`, so a deployment needs that file to be present.
#
# The PUBLIC_* variables reach the browser and are declared in `src/env.d.ts`.
# API_PROXY_TARGET is a dev-server setting, read in `astro.config.mjs`.

# Base URL of the usage API. Empty means same origin, which is how a deployment
# serves the frontend and the API together. Set it only to point the frontend at an
# API on another host, which requires CORS on the backend. `npm run dev` does not
# need it and proxies /api instead (see API_PROXY_TARGET below).
# PUBLIC_API_BASE=

# Company or organization name, shown in the page title:
# "Company-wide token and CO₂ consumption from AI agents at <your company>."
# PUBLIC_COMPANY_NAME=

# Where the usage-reporting plugins live, two URLs per provider. _REPO is the repository
# shown and cloned (with `.git` appended) by the install command on the provider pages;
# _RAW is the raw-file base the installed plugin auto-updates from — so whoever sets it
# decides the update source of everyone who installs the plugin. Both default to the
# upstream repositories below. Hosting your own forks: copy the two URLs from each
# plugin's README, e.g. https://gitlab.example.com/<group>/<repo> and
# https://gitlab.example.com/<group>/<repo>/-/raw/main for a GitLab fork.
# PUBLIC_PLUGIN_CLAUDE_REPO=https://github.com/neuland/tokendashboard-plugin-claude
# PUBLIC_PLUGIN_CLAUDE_RAW=https://raw.githubusercontent.com/neuland/tokendashboard-plugin-claude/main
# PUBLIC_PLUGIN_COPILOT_REPO=https://github.com/neuland/tokendashboard-plugin-copilot
# PUBLIC_PLUGIN_COPILOT_RAW=https://raw.githubusercontent.com/neuland/tokendashboard-plugin-copilot/main
# PUBLIC_PLUGIN_OPENCODE_REPO=https://github.com/neuland/tokendashboard-plugin-opencode
# PUBLIC_PLUGIN_OPENCODE_RAW=https://raw.githubusercontent.com/neuland/tokendashboard-plugin-opencode/main

# Backend the dev server proxies /api to; defaults to http://localhost:8080. Read by
# `astro dev` only — a built frontend calls its API same-origin. Set it to develop
# against a backend that is not on that port. A shell variable of the same name takes
# precedence over this file:
#   API_PROXY_TARGET=https://backend.example.com npm run dev
# API_PROXY_TARGET=
