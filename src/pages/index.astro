---
import LayoutNext from '~/layouts/LayoutNext.astro';
import DashboardNext from '~/components/next/DashboardNext.tsx';
import { dict, DEFAULT_LOCALE, type Locale } from '~/i18n';
import { COMPANY_NAME } from '~/lib/company';

const locale = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const t = dict(locale);
---

<LayoutNext>
  <DashboardNext client:only="react" locale={locale} title={t.header.defaultTitle} lede={t.header.defaultLede(COMPANY_NAME)} />
</LayoutNext>
