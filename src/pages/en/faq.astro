---
import LayoutNext from '~/layouts/LayoutNext.astro';
import PageIntroNext from '~/components/next/PageIntroNext.astro';
import FaqEn from '~/components/faq/FaqEn.astro';
import { dict, DEFAULT_LOCALE, type Locale } from '~/i18n';
import { COMPANY_NAME } from '~/lib/company';

const locale = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const t = dict(locale);
---

<LayoutNext title={t.faqPage.title(COMPANY_NAME)}>
  <PageIntroNext title={t.faqPage.headerTitle} lede={t.faqPage.headerLede} />
  <div class="nx-faq"><FaqEn /></div>
</LayoutNext>
