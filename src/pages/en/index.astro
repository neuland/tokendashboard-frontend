---
import Layout from '~/layouts/Layout.astro';
import Dashboard from '~/components/Dashboard.tsx';
import { dict, DEFAULT_LOCALE, type Locale } from '~/i18n';
import { COMPANY_NAME } from '~/lib/company';

const locale = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const t = dict(locale);
---

<Layout>
  <Dashboard client:only="react" locale={locale} title={t.header.defaultTitle} lede={t.header.defaultLede(COMPANY_NAME)} />
</Layout>
