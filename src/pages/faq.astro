---
import Layout from '~/layouts/Layout.astro';
import PageIntro from '~/components/PageIntro.astro';
import FaqDe from '~/components/faq/FaqDe.astro';
import { dict, DEFAULT_LOCALE, type Locale } from '~/i18n';
import { COMPANY_NAME } from '~/lib/company';

const locale = (Astro.currentLocale as Locale | undefined) ?? DEFAULT_LOCALE;
const t = dict(locale);
---

<Layout title={t.faqPage.title(COMPANY_NAME)}>
  <PageIntro title={t.faqPage.headerTitle} lede={t.faqPage.headerLede} />
  <div class="app-faq"><FaqDe /></div>
</Layout>
